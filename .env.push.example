# Push Notification Configuration

# Firebase Configuration for Android Push Notifications
FIREBASE_PROJECT_ID=cotaja
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxx@cotaja.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_FIREBASE_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# iOS Push Notification Configuration
IOS_PEM_CERT_PATH=./certificates/ios-push.pem
IOS_APP_BUNDLE=com.cotaja

# Note:
# 1. Replace the Firebase credentials with your actual Firebase service account credentials
# 2. Place your iOS .pem certificate file in the certificates/ directory
# 3. Update the app bundle identifier to match your iOS app
# 4. Add these variables to your main .env file